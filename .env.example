# ============================================
# MoveInMate — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git!

# External Fernet key for encrypted DB settings and temporary-password handover.
# Keep the existing key unchanged; back it up separately from PostgreSQL.
SETTINGS_ENCRYPTION_KEY=
SETTINGS_SOURCE=env

# ---- LLM Configuration ----
# auto | openai | openrouter | gemini | custom
LLM_PROVIDER=auto

# In auto mode, the first valid key wins: custom, OpenAI, OpenRouter, Gemini.
# Leave unused keys empty. Template/placeholder values are ignored.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5-nano
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_APP_NAME=MoveInMate AI

GEMINI_API_KEY=
# GOOGLE_API_KEY is accepted as a fallback alias for Gemini.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Free-tier multilingual Text-to-Speech. Reuses GEMINI_API_KEY by default.
GEMINI_TTS_API_KEY=
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Aoede
GEMINI_TTS_BASE_URL=https://generativelanguage.googleapis.com

# OMI Technology / OMICX Voice API (server-side Speech-to-Text).
OMICX_API_KEY=
OMICX_STT_URL=https://api.omicx.one/stt

# PTIT Holobox speech APIs. Select ptit and fill the two endpoint URLs to use them.
# These four fields stay in env even when SETTINGS_SOURCE=postgresql.
TTS_PROVIDER=gemini
STT_PROVIDER=omicx
CHAT_REQUESTS_PER_10_MINUTES=30
AI_REQUESTS_PER_10_MINUTES=300
AI_INGRESS_REQUESTS_PER_10_MINUTES=600
AI_IP_REQUESTS_PER_10_MINUTES=120
AI_LLM_REQUESTS_PER_10_MINUTES=120
AI_TTS_REQUESTS_PER_10_MINUTES=240
AI_TTS_CHARS_PER_10_MINUTES=60000
AI_STT_REQUESTS_PER_10_MINUTES=30
AI_OCR_REQUESTS_PER_10_MINUTES=30
AI_MAX_CONCURRENT=6
AI_LLM_MAX_CONCURRENT=3
AI_TTS_MAX_CONCURRENT=2
AI_STT_MAX_CONCURRENT=1
AI_OCR_MAX_CONCURRENT=1
AI_LLM_TIMEOUT_SECONDS=60
PTIT_TTS_TIMEOUT_SECONDS=30
DOCUMENT_EXTRACTIONS_PER_10_MINUTES=5
SPEECH_REQUESTS_PER_10_MINUTES=60
TRANSCRIPTION_REQUESTS_PER_10_MINUTES=10
PTIT_TTS_URL=
PTIT_STT_URL=

# Any other OpenAI-compatible provider. Fill all three values and select custom.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# ---- Database ----
POSTGRES_DB=moveinmate_dev
POSTGRES_USER=moveinmate
POSTGRES_PASSWORD=
POSTGRES_TEST_DB=moveinmate_test
POSTGRES_PORT=5432
BACKEND_PORT=8000
DATABASE_URL='postgresql+psycopg2://moveinmate:your-password@localhost:5432/moveinmate_dev'
TEST_DATABASE_URL='postgresql+psycopg2://moveinmate:your-password@localhost:5432/moveinmate_test'
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30
DB_CONNECT_TIMEOUT_SECONDS=10
DB_HOST_OVERRIDE=
ALLOW_DEMO_RESET=false
LOGIN_RESET_ENABLED=false
LOGIN_RESET_CODE=
LOGIN_RESET_PRESERVED_USERNAMES=

# ---- Legacy runtime path (no Chroma dependency or vector index writes) ----
CHROMA_PERSIST_DIR=./.runtime/chroma
KNOWLEDGE_DIR=./src/project_packs/knowledge
INCLUDE_DEMO_KNOWLEDGE=false

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000,http://localhost:5173

# ---- Authentication ----
# required is the safe default. Use demo only for local development/tests;
# demo mode is rejected outside APP_ENV=development/test.
AUTH_MODE=required
ALLOW_DEMO_AUTH=false
AUTH_PROVIDER=local
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=moveinmate-local
AUTH_JWT_AUDIENCE=moveinmate
AUTH_JWT_LEEWAY_SECONDS=60
AUTH_SESSION_TTL_SECONDS=28800
LOCAL_AUTH_ADMIN_USERNAME=admin
LOCAL_AUTH_ADMIN_PASSWORD=
LOCAL_AUTH_USER_USERNAME=user
LOCAL_AUTH_USER_PASSWORD=
LOCAL_AUTH_SITE_ID=sunrise-residence
LOCAL_AUTH_ADMIN_SITE_IDS=vinhomes-ocean-park,vinhomes-smart-city,vinhomes-grand-park,vinhomes-central-park,vinhomes-riverside,vinhomes-times-city,vinhomes-royal-city,masteri-thao-dien,masteri-an-phu
LOCAL_AUTH_USER_RESIDENT_ID=R001
SHOW_LOCAL_LOGIN_CREDENTIALS=false
# ---- Optional tracing is disabled by default ----
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false

# ---- Logging ----
LOG_LEVEL=INFO

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
